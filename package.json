{
  "name": "picimpact",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "ready": "vp check",
    "web:dev": "pnpm --filter @picimpact/web run dev",
    "web:migrate": "pnpm --filter @picimpact/web run migrate",
    "web:build": "pnpm --filter @picimpact/web run build",
    "web:start": "pnpm --filter @picimpact/web run start",
    "web:dev:cloudflare": "pnpm --filter @picimpact/web run dev:cloudflare",
    "web:build:cloudflare": "pnpm --filter @picimpact/web run build:cloudflare",
    "web:deploy:cloudflare": "pnpm --filter @picimpact/web run deploy:cloudflare",
    "web:test": "pnpm --filter @picimpact/web test",
    "web:test:watch": "pnpm --filter @picimpact/web test:watch",
    "web:typecheck": "pnpm --filter @picimpact/web typecheck",
    "web:check": "pnpm run web:typecheck && pnpm run web:test",
    "web:db:generate": "pnpm --filter @picimpact/web db:generate"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "9.15.9",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "vite@*": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
