{
  "name": "picimpact",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "ready": "vp check"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "9.15.9",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "vite@*": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite"
      ],
      "allowedVersions": {
        "vite": "*"
      }
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
